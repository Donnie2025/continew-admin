<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="top.continew.admin.education.mapper.MaterialLessonMapper">
    <!-- 课节结果映射（将edu_material表的LESSON类型记录映射到MaterialLessonDO） -->
    <resultMap id="lessonResultMap" type="top.continew.admin.education.model.entity.MaterialLessonDO">
        <id column="id" property="id"/>
        <result column="pid" property="materialId"/>
        <result column="name" property="lessonName"/>
        <result column="lesson_url" property="lessonUrl"/>
        <result column="type" property="type"/>
        <result column="status" property="status"/>
        <result column="create_user" property="createUser"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
</mapper>