<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="top.continew.admin.education.mapper.TransactionMapper">

    <resultMap id="TransactionRespMap" type="top.continew.admin.education.model.resp.TransactionResp">
        <id column="id" property="id"/>
        <result column="student_id" property="stuId"/>
        <result column="student_name" property="stuName"/>
        <result column="card_title" property="cardTitle"/>
        <result column="trans_type" property="type"/>
        <result column="direction" property="direction"/>
        <result column="amount" property="amount"/>
        <result column="balance" property="afterAmount"/>
        <result column="cash_amount" property="actualAmount"/>
        <result column="remark" property="remark"/>
        <result column="operator_name" property="operatorName"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user" property="createUser"/>
        <result column="create_user_string" property="createUserString"/>
    </resultMap>

    <select id="selectPageList" resultMap="TransactionRespMap">
        SELECT
            t.id,
            t.student_id,
            t.student_name,
            t.card_title,
            t.trans_type,
            t.direction,
            t.amount,
            t.balance,
            t.cash_amount,
            t.remark,
            t.create_time,
            t.create_user,
            u.nickname as operator_name,
            u.username as create_user_string
        FROM edu_transaction t
        LEFT JOIN sys_user u ON t.create_user = u.id
        <where>
            <if test="query.studentId != null">
                AND t.student_id = #{query.studentId}
            </if>
            <if test="query.cardId != null">
                AND t.card_id = #{query.cardId}
            </if>
            <if test="query.type != null and query.type != ''">
                AND t.trans_type = #{query.type}
            </if>
        </where>
        ORDER BY t.id DESC
    </select>

</mapper>